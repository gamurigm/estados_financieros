    "name": "Estados financieros",
    "slug": "estados-financieros-android",
    "scheme": "estadosfinancieros",
    "version": "1.0.2",
    "icon": "./assets/icon-finance.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "versionCode": 3,
      "package": "com.gabrielmurillo.estadosfinancieros",
