{
  "name": "estados-financieros",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "tsx watch server/index.ts",
    "api:start": "tsx server/index.ts",
    "db:up": "node scripts/prepare-local.mjs && docker compose up -d --wait db",
    "db:migrate": "node scripts/migrate.mjs",
    "test:server": "tsx --test server/auth-crypto.test.ts server/auth-routes.test.ts",
    "test:web": "tsx --test src/auth.test.ts",
    "test:mobile": "tsx --test mobile/src/auth/session.test.ts mobile/src/features/ledger/selectors.test.ts mobile/src/features/movements/validation.test.ts mobile/src/features/settings/requests.test.ts",
    "test:scripts": "node --test scripts/backup-cloud.test.mjs",
    "owner:create": "tsx scripts/create-owner.mjs",
    "local": "npm run db:up && npm run db:migrate && concurrently -k \"npm run api\" \"npm run dev\"",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "backup:cloud": "node scripts/backup-cloud.mjs",
    "restore:cloud": "node scripts/restore-cloud.mjs",
    "migrate:cloud": "node scripts/migrate-cloud.mjs",
    "verify:cloud": "node scripts/verify-cloud.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ionic/react": "^9.0.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "ionicons": "^8.0.0",
    "pg": "^8.15.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
