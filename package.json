{
  "name": "estados-financieros",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "tsx watch server/index.ts",
    "db:up": "node scripts/prepare-local.mjs && docker compose up -d --wait db",
    "local": "npm run db:up && concurrently -k \"npm run api\" \"npm run dev\"",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ionic/react": "^9.0.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "ionicons": "^8.0.0",
    "pg": "^8.15.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "typescript": "~5.8.3",
    "tsx": "^4.19.4",
    "vite": "^6.3.5"
  }
}
